{
  "description": "Report Claude Code lifecycle to eMterm agent-status",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notify-status.sh",
            "args": ["working"],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notify-status.sh",
            "args": ["working"],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notify-status.sh",
            "args": ["working"],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notify-status.sh",
            "args": ["idle"],
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "^(permission_prompt|elicitation_dialog|agent_needs_input)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notify-status.sh",
            "args": ["blocked"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
