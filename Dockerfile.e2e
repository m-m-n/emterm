# E2E Test Environment for Tauri Application
# Based on Debian Bookworm with all necessary dependencies

FROM debian:bookworm-slim

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for Tauri and WebDriver
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential \
    pkg-config \
    curl \
    ca-certificates \
    git \
    # Tauri dependencies (GTK, WebKitGTK)
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libappindicator3-dev \
    librsvg2-dev \
    librsvg2-bin \
    # Display and WebDriver
    xvfb \
    webkit2gtk-driver \
    # Additional libraries
    libssl-dev \
    libsoup-3.0-dev \
    # Japanese fonts (for IME testing later)
    fonts-noto-cjk \
    # For Bun installation
    unzip \
    # ImageMagick for creating test images
    imagemagick \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Node.js (for running tests - better compatibility with WebdriverIO)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Bun (for building the app)
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

# Install wasm-pack (for WASM build)
RUN curl --proto '=https' --tlsv1.2 -sSf https://rustwasm.github.io/wasm-pack/installer/init.sh | sh

# Install tauri-cli and tauri-driver
RUN cargo install tauri-cli tauri-driver

# Install treemd (ratatui-based TUI Markdown viewer for Kitty protocol testing)
RUN cargo install treemd

# Set display for Xvfb
ENV DISPLAY=:99

# Create large test image (1080x1920) for zoom testing (8-bit depth to ensure RGBA not RGBA16)
RUN convert -size 1080x1920 -depth 8 xc:blue -fill white -draw "rectangle 100,100 980,1820" -fill red -draw "circle 540,960 540,500" /tmp/large-test.png

# Ensure cargo binaries are in PATH for all shells
# Add emterm binary to PATH after build (created during test run)
ENV PATH="/root/.cargo/bin:/root/.bun/bin:/app/src-tauri/target/debug:${PATH}"

WORKDIR /app

# -- Layer cache optimization: copy dependency files first --
COPY package.json bun.lock ./
COPY wasm/Cargo.toml ./wasm/
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock ./src-tauri/
COPY e2e-tests/package.json e2e-tests/package-lock.json ./e2e-tests/

# bun install (postinstall generate-icons.sh needs src-tauri/icons to exist)
RUN mkdir -p src-tauri/icons && bun install
RUN cd e2e-tests && npm ci --legacy-peer-deps

# -- Copy full source code (.dockerignore excludes unnecessary files) --
COPY . .

# -- WASM build --
RUN cd wasm && wasm-pack build --target web --out-dir pkg

# -- Tauri app build --
RUN bun tauri build --debug --no-bundle
