{
	"name": "emterm",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"postinstall": "bash scripts/generate-icons.sh || true",
		"build:wasm": "cd wasm && wasm-pack build --target web --out-dir pkg && cd .. && bash scripts/patch-wasm-bindgen.sh",
		"dev": "bun run build:wasm && bun run --hot serve.ts",
		"icons": "bash scripts/generate-icons.sh",
		"prebuild": "bash scripts/generate-icons.sh",
		"build": "bun run build:wasm && bun build src/index.html --outdir dist --minify && cp wasm/pkg/emterm_wasm_bg.wasm dist/",
		"build:viewer": "bun build native-poc/viewer/web/index.html --outdir native-poc/viewer/dist --minify --entry-naming '[dir]/[name].[ext]' --asset-naming '[name].[ext]'",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"pretest": "bun run build:wasm",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"dpkg": "./scripts/build-dpkg.sh",
		"clean": "rm -rf build dist"
	},
	"devDependencies": {
		"@tauri-apps/api": "^2.0.0",
		"@tauri-apps/cli": "^2.9.6",
		"@types/bun": "latest",
		"@types/dompurify": "^3.2.0",
		"@wdio/cli": "^9.22.0",
		"happy-dom": "^20.3.1",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-log": "^2.7.1",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-shell": "^2.3.4",
		"dompurify": "^3.3.1",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.1",
		"mermaid": "^11.12.2",
		"yaml": "^2.8.2"
	}
}
