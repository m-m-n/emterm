{
	"name": "emterm",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build:viewer": "bun build src-tauri/viewer/web/index.html --outdir src-tauri/viewer/dist --minify --entry-naming '[dir]/[name].[ext]' --asset-naming '[name].[ext]'",
		"build:settings": "bun build src-tauri/settings/web/index.html --outdir src-tauri/settings/dist --minify --entry-naming '[dir]/[name].[ext]' --asset-naming '[name].[ext]'",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/dompurify": "^3.2.0",
		"happy-dom": "^20.3.1",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.0.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-shell": "^2.3.4",
		"dompurify": "^3.3.1",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.1",
		"mermaid": "^11.12.2",
		"yaml": "^2.8.2"
	}
}
