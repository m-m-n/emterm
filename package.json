{
	"name": "emterm",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"postinstall": "./scripts/generate-icons.sh",
		"dev": "bun run --hot serve.ts",
		"icons": "./scripts/generate-icons.sh",
		"prebuild": "./scripts/generate-icons.sh",
		"build": "bun build src/main.ts --outdir dist --minify && cp src/index.html dist/ && cat src/styles/tab-bar.css src/styles/settings-panel.css src/styles.css | grep -v '@import' > dist/styles.css && sed -i 's/main.ts/main.js/g' dist/index.html",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"dpkg": "./scripts/build-dpkg.sh",
		"clean": "rm -rf build dist"
	},
	"devDependencies": {
		"@tauri-apps/api": "^2.0.0",
		"@tauri-apps/cli": "^2.9.6",
		"@types/bun": "latest",
		"@types/dompurify": "^3.2.0",
		"@wdio/cli": "^9.22.0",
		"happy-dom": "^20.3.1",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-log": "^2.7.1",
		"@tauri-apps/plugin-shell": "^2.3.4",
		"dompurify": "^3.3.1",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.1",
		"mermaid": "^11.12.2"
	}
}
